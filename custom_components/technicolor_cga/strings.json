{
  "config": {
    "step": {
      "user": {
        "title": "Technicolor CGA cable gateway",
        "description": "Address and login of the gateway's local web interface. The gateway allows one web session at a time: while you are logged in to its web interface, polling pauses.",
        "data": {
          "host": "Address",
          "username": "Username",
          "password": "Password",
          "take_over_session": "End other web sessions"
        },
        "data_description": {
          "host": "Usually 192.168.0.1 in router mode, or 192.168.100.1.",
          "username": "The login of the web interface, usually \"user\".",
          "take_over_session": "Log in even when someone is logged in to the web interface, which logs them out. Leave this off to keep the web interface usable."
        }
      },
      "reauth_confirm": {
        "title": "Log in again",
        "description": "The gateway rejected the stored password.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the gateway, or it gave an unexpected answer.",
      "invalid_auth": "Wrong username or password.",
      "invalid_host": "Enter only the address, without a path.",
      "session_busy": "Someone is logged in to the gateway's web interface. Log out there, or enable \"End other web sessions\".",
      "locked_out": "The gateway blocks logins after failed attempts. Wait a few minutes and try again."
    },
    "abort": {
      "already_configured": "This gateway is already configured.",
      "reauth_successful": "Logged in again."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
